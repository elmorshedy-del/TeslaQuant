# Copy to .env; chmod 600 .env. Never commit real secrets.
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Only required for authenticated public HTTPS.
LAB_DOMAIN=
LAB_USERNAME=research
# Use single quotes around the bcrypt hash to preserve dollar signs.
LAB_PASSWORD_HASH=

# Optional durable off-server backups; bucket must already exist.
SPACES_ENDPOINT=
SPACES_REGION=nyc3
SPACES_BUCKET=
SPACES_ACCESS_KEY=
SPACES_SECRET_KEY=
